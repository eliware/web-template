{
  "name": "@eliware/web-template",
  "type": "module",
  "version": "9.0.0",
  "description": "A Node.js web application template with explicit assets, routes, build, and deployment boundaries.",
  "main": "web-template.mjs",
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "build": "webpack --entry ./src/client-entry.mjs --output-path ./dist --output-filename client.js --mode production && webpack-cli --version",
    "lighthouse": "lighthouse http://127.0.0.1:3000 --only-categories=accessibility --output=json --output-path=artifacts/lighthouse.json --chrome-flags=--headless",
    "puppeteer": "puppeteer browsers install chrome"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliware/web-template"
  },
  "keywords": [
    "web-template",
    "web",
    "nodejs",
    "starter",
    "template"
  ],
  "author": "Eli Sterling, eliware.org <eli@eliware.org>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "26"
  },
  "eliware": {
    "apply": [
      "general",
      "application",
      "web",
      "ghcr-published"
    ]
  },
  "bugs": {
    "url": "https://github.com/eliware/web-template/issues"
  },
  "homepage": "https://github.com/eliware/web-template#readme",
  "devDependencies": {
    "@eliware/test": "^8.0.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^7.2.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "dependencies": {
    "@eliware/common": "^2.0.0",
    "dotenv": "^18.0.5",
    "lighthouse": "^13.5.0",
    "puppeteer": "^25.12.0"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  }
}
